# Copy to deploy/.env and customize before first deploy.

# Public URL users open in the browser (no trailing slash). Used for CORS.
# Examples: http://203.0.113.10  https://sarthi.example.com
PUBLIC_URL=http://localhost

# HTTP port exposed on the host (nginx)
HTTP_PORT=80

# Database (internal to Docker network)
POSTGRES_DB=sarthi_preprod
POSTGRES_USER=sarthi
POSTGRES_PASSWORD=change-me-strong-db-password

# JWT signing key — at least 32 random characters
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: remote deploy target (used by deploy.sh)
# DEPLOY_HOST=ubuntu@your-server-ip
# DEPLOY_PATH=/opt/sarthi
